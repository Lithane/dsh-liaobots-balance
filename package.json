{
  "name": "dsh-liaobots-balance",
  "version": "1.1.0",
  "description": "Liaobots credit-balance widget for the DeepSeek Harness GUI: a sidebar footer card shows the remaining Liaobots credits and opens a popover with total quota and the most recent deductions. Host half proxies the documented GET /api/v1/credits endpoint (loopback-only routes, credential never reaches the browser); browser half renders the card with the same look as dsh-balance-widget. Zero runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "npm run test:host && npm run test:package && npm run test:client",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:package": "node test/package.test.mjs",
    "test:install": "npm --prefix test ci"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "liaobots",
    "balance",
    "credits",
    "web-ui"
  ],
  "license": "MIT",
  "author": "Li Yi <thliyi@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lithane/dsh-liaobots-balance.git"
  },
  "homepage": "https://github.com/Lithane/dsh-liaobots-balance#readme",
  "bugs": {
    "url": "https://github.com/Lithane/dsh-liaobots-balance/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
